{
  "manifest_version": 3,
  "name": "Python Gate",
  "version": "1.1",
  "description": "Answer short Python questions to earn time on distracting sites.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Python Gate",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["sites.js", "questions.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
